[Unit]
Description=jobagent daily crawl: pull every configured source, then score for every user
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ayman
Group=ayman
WorkingDirectory=/srv/jobagent
ExecStart=/srv/llm/miniforge3/envs/jobagent/bin/jobagent pipeline "Daily pull: at most 200 new postings per target from every configured source, posted in the last 48 hours."
TimeoutStartSec=4h
