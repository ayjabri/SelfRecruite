[Unit]
Description=jobagent job review web page
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ayman
Group=ayman
WorkingDirectory=/srv/jobagent
# Listens on localhost only; Caddy (deploy/Caddyfile) serves it on port 80 / 443.
ExecStart=/srv/llm/miniforge3/envs/jobagent/bin/jobagent ui --host 127.0.0.1 --port 8765 --no-reload --proxy-headers
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/jobagent/data /srv/jobagent/config

[Install]
WantedBy=multi-user.target
