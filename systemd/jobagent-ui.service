[Unit]
Description=jobagent job review web page
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ayman
Group=ayman
WorkingDirectory=/srv/jobagent
# Listens on every interface: anyone on the network can view and change your job list.
ExecStart=/srv/llm/miniforge3/envs/jobagent/bin/jobagent ui --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
