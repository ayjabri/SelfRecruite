[Unit]
Description=jobagent job review web page
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
# Listens on localhost only; Caddy (deploy/Caddyfile) serves it on port 80 / 443.
ExecStart=__BIN_DIR__/jobagent ui --host 127.0.0.1 --port 8765 --no-reload --proxy-headers
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__INSTALL_DIR__/data __INSTALL_DIR__/config

[Install]
WantedBy=multi-user.target
