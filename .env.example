# SelfRecruite configuration. Copy to .env; every value the code reads is listed here.
# Docker Compose reads this file too (database name/password, ports, profiles).

# --- Database (Postgres with the pgvector extension) ------------------------------------------
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobagent
# Native installs connect here. Under Docker Compose the app is pointed at the `db` service.
DATABASE_URL=postgresql+psycopg://jobagent:change-me@127.0.0.1:5432/jobagent

# --- Language models ----------------------------------------------------------------------------
# The shared chat model, as "<provider>:<model>":
#   ollama:<tag>        a local model served by Ollama (free; pick a tag that fits your GPU or RAM)
#   anthropic:<model>   Claude through your ANTHROPIC_API_KEY, e.g. anthropic:claude-sonnet-5-5
#   openai:<model>      OpenAI through your OPENAI_API_KEY, e.g. openai:gpt-5
# Signed-in users can also store their own Claude key on the Settings page.
LLM_MODEL=ollama:qwen3.6:27b
# Where Ollama listens. Native installs: localhost. Compose points the app at its own `ollama` service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
# Embeddings always come from Ollama (job postings and resume sections are embedded locally).
EMBED_MODEL=nomic-embed-text
# Only needed when LLM_MODEL names that provider.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Secrets --------------------------------------------------------------------------------------
# Encrypts the LLM API keys users store in their profile (Fernet). Generate with: jobagent secret-key
# Left unset, a key is generated once and kept in data/secret.key.
# SECRET_KEY=

# --- Accounts -------------------------------------------------------------------------------------
# Read once, when the first migration creates the admin account (user 1). Claim it afterwards with
#   jobagent passwd --user 1 --email you@example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# Who the CLI acts as when no user is given (user 1 = the admin).
# DEFAULT_USER_ID=1
# Optional: a markdown resume imported as user 1's first resume on the first run.
# Otherwise upload one on the page.
# GOLDEN_SOURCE_FILE=data/resume.md

# --- Web page -------------------------------------------------------------------------------------
# SESSION_DAYS=30
# COOKIE_SECURE=true        # once the page is served over HTTPS
# REGISTRATION_OPEN=true    # false: only existing accounts can sign in
# Behind a reverse proxy (with --proxy-headers): which addresses may set X-Forwarded-* ("*" for any).
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Config file locations (defaults: the config/ folder) --------------------------------------
# COMPANIES_FILE=config/companies.yaml
# FILTERS_FILE=config/filters.yaml
# TARGETS_FILE=config/targets.yaml

# --- Docker Compose only --------------------------------------------------------------------------
# Start the bundled Ollama (and pull the models). Clear this to use an Ollama on the host instead.
COMPOSE_PROFILES=ollama
# Where the page is published on the host. 0.0.0.0 makes it reachable from your LAN.
UI_BIND=127.0.0.1
UI_PORT=8765
# Host port for the database container (change it if something already listens on 5432).
DB_PORT=5432

# --- Backups (scripts/backup_db.sh) ---------------------------------------------------------------
# Off-box copy of each nightly dump: rsync target (user@host:/path/) or rclone remote (name:bucket/path)
# BACKUP_REMOTE=
