POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobagent
DATABASE_URL=postgresql+psycopg://jobagent:change-me@127.0.0.1:5432/jobagent
# "<provider>:<model>". For Claude: anthropic:<model id>, plus ANTHROPIC_API_KEY and `pip install -e .[anthropic]`
LLM_MODEL=ollama:qwen3.6:27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
EMBED_MODEL=nomic-embed-text
# GOLDEN_SOURCE_FILE=docs/Ethan_Jabri_Golden_Source_Resume.md
# Multi-user: who the CLI and the web page act as until sign-in exists (user 1 = the admin
# created by the migration). ADMIN_EMAIL/ADMIN_NAME are read once, when that migration runs.
# DEFAULT_USER_ID=1
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# Encrypts the LLM API keys users store in their profile. Generate with:  jobagent secret-key
# SECRET_KEY=
